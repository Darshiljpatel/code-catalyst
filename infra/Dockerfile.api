FROM python:3.14-slim
WORKDIR /app
ENV PYTHONPATH=/app/apps/api:/app/packages:/app PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
COPY apps/api/requirements.lock /app/requirements.lock
RUN pip install --no-cache-dir -r requirements.lock
COPY packages/ ./packages/
COPY apps/api/ ./apps/api/
COPY contracts/ ./contracts/
RUN useradd --create-home app
USER app
EXPOSE 8000
HEALTHCHECK --interval=5s --timeout=5s --retries=10 CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/v1/health/ready', timeout=3)"
CMD ["uvicorn", "brandguard.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
