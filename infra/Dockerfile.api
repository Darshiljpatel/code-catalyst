FROM python:3.13-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
COPY packages/ ./packages/
COPY apps/api/ ./apps/api/
COPY contracts/ ./contracts/

RUN pip install --no-cache-dir -e .
RUN pip install --no-cache-dir uvicorn fastapi pydantic psycopg[binary] sqlalchemy alembic httpx

EXPOSE 8000

HEALTHCHECK --interval=5s --timeout=5s --retries=5 CMD curl -f http://localhost:8000/api/v1/health/ready || exit 1


CMD ["uvicorn", "brandguard.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
