FROM python:3.14-slim
WORKDIR /app
ENV PYTHONPATH=/app/apps/api:/app/packages:/app PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
COPY apps/api/requirements.lock /app/requirements.lock
RUN pip install --no-cache-dir -r requirements.lock
COPY packages/ ./packages/
COPY apps/api/ ./apps/api/
COPY apps/worker/ ./apps/worker/
COPY contracts/ ./contracts/
COPY infra/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh
RUN useradd --create-home app
USER app
EXPOSE 8000
HEALTHCHECK --interval=5s --timeout=5s --retries=10 CMD python -c "import os, urllib.request; p = os.environ.get('PORT', '8000'); urllib.request.urlopen(f'http://localhost:{p}/api/v1/health/ready', timeout=3)"
CMD ["/app/entrypoint.sh"]
