DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/brandguard
# For Vite UI development, set this to http://localhost:5173 (the actual browser origin).
PUBLIC_ORIGIN=http://localhost:8000
APP_ENV=development
# S3 provider configuration; external inference also requires workspace policy and creator consent.
MODEL_PROVIDER=nebius
MODEL_BASE_URL=https://api.tokenfactory.nebius.com/v1/
MODEL_PRIMARY_ID=Qwen/Qwen3-235B-A22B-Instruct-2507
NEBIUS_API_KEY=

MODEL_TIMEOUT_SECONDS=40
MODEL_MAX_INPUT_BYTES=24000
MODEL_MAX_OUTPUT_TOKENS=1200
MODEL_DAILY_RUN_LIMIT=100

# Docker Compose only: use a URL-safe random password. Local origin must match web port.
POSTGRES_PASSWORD=
# PUBLIC_ORIGIN=http://localhost:3000
# Production: APP_ENV=production, PUBLIC_ORIGIN=https://your.domain, SITE_ADDRESS=your.domain

# Set to 1 only behind a proxy that overwrites X-Forwarded-For (Vercel -> Render).
TRUST_PROXY_HEADERS=
# Deployed commit for /api/v1/health/version (Render sets RENDER_GIT_COMMIT automatically).
GIT_COMMIT_SHA=
# Worker: set to 0 to switch off image OCR (uploads then need the text typed by hand).
OCR_ENABLED=1
# Private demo sandboxes ("Try a private demo"); set to 0 to switch them off.
DEMO_SANDBOXES_ENABLED=1
