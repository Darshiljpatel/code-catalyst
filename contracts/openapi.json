  "components": {
    "schemas": {
      "ActivationInput": {
        "properties": {
          "expected_epoch": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Epoch"
          },
          "verified": {
            "type": "boolean",
            "const": true,
            "title": "Verified"
          },
          "retire_source_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Retire Source Ids"
          },
          "rationale": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 10,
            "title": "Rationale"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_epoch",
          "verified",
          "rationale"
        ],
        "title": "ActivationInput"
      },
      "CheckOut": {
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "terminology",
              "tone",
              "messaging",
              "facts_claims",
              "visual",
              "accessibility"
            ],
            "title": "Category"
          },
          "status": {
            "type": "string",
            "enum": [
              "complete",
              "unavailable",
              "failed",
              "needs_manual_review",
              "not_applicable"
            ],
            "title": "Status"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "category",
          "status",
          "reason"
        ],
        "title": "CheckOut"
      },
      "ContentInput": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 100000,
            "minLength": 1,
            "title": "Text"
          },
          "channel": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Channel"
          },
          "audience": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Audience"
          },
          "purpose": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Purpose"
          },
          "brand_id": {
            "type": "string",
            "maxLength": 36,
            "minLength": 1,
            "title": "Brand Id"
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "reviewer_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 36,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Reviewer Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "channel",
          "audience",
          "purpose",
          "brand_id",
          "title"
        ],
        "title": "ContentInput"
      },
      "ContentOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "brand_id": {
            "type": "string",
            "title": "Brand Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "creator_id": {
            "type": "string",
            "title": "Creator Id"
          },
          "reviewer_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reviewer Id"
          },
          "current_revision": {
            "type": "integer",
            "title": "Current Revision"
          },
          "state": {
            "type": "string",
            "title": "State"
          },
          "revisions": {
            "items": {
              "$ref": "#/components/schemas/RevisionOut"
            },
            "type": "array",
            "title": "Revisions"
          }
        },
        "type": "object",
        "required": [
          "id",
          "brand_id",
          "title",
          "creator_id",
          "reviewer_id",
          "current_revision",
          "state",
          "revisions"
        ],
        "title": "ContentOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Login": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 3,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Password"
          },
          "org_id": {
            "type": "string",
            "maxLength": 36,
            "minLength": 1,
            "title": "Org Id"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password",
          "org_id"
        ],
        "title": "Login"
      },
      "NewBrand": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "NewBrand"
      },
      "NewRevisionInput": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 100000,
            "minLength": 1,
            "title": "Text"
          },
          "channel": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Channel"
          },
          "audience": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Audience"
          },
          "purpose": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Purpose"
          },
          "parent_revision_id": {
            "type": "string",
            "maxLength": 36,
            "minLength": 1,
            "title": "Parent Revision Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "channel",
          "audience",
          "purpose",
          "parent_revision_id"
        ],
        "title": "NewRevisionInput"
      },
      "RevisionOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "item_id": {
            "type": "string",
            "title": "Item Id"
          },
          "number": {
            "type": "integer",
            "title": "Number"
          },
          "author_id": {
            "type": "string",
            "title": "Author Id"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "text_hash": {
            "type": "string",
            "title": "Text Hash"
          },
          "channel": {
            "type": "string",
            "title": "Channel"
          },
          "audience": {
            "type": "string",
            "title": "Audience"
          },
          "purpose": {
            "type": "string",
            "title": "Purpose"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "item_id",
          "number",
          "author_id",
          "text",
          "text_hash",
          "channel",
          "audience",
          "purpose",
          "created_at"
        ],
        "title": "RevisionOut"
      },
      "RuleInput": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Id"
          },
          "category": {
            "type": "string",
            "enum": [
              "terminology",
              "tone",
              "messaging",
              "facts_claims",
              "visual",
              "accessibility"
            ],
            "title": "Category"
          },
          "kind": {
            "type": "string",
            "enum": [
              "terminology",
              "fact",
              "claim_policy",
              "guidance",
              "asset",
              "contrast",
              "alt_text"
            ],
            "title": "Kind"
          },
          "key": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Key"
          },
          "value": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Value"
          },
          "evidence_quote": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Evidence Quote"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "category",
          "kind",
          "key",
          "value",
          "evidence_quote"
        ],
        "title": "RuleInput"
      },
      "RunOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "revision_id": {
            "type": "string",
            "title": "Revision Id"
          },
          "source_epoch": {
            "type": "integer",
            "title": "Source Epoch"
          },
          "source_snapshot": {
            "items": {
              "$ref": "#/components/schemas/SourceOut"
            },
            "type": "array",
            "title": "Source Snapshot"
          },
          "checks": {
            "items": {
              "$ref": "#/components/schemas/CheckOut"
            },
            "type": "array",
            "title": "Checks"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "stale": {
            "type": "boolean",
            "title": "Stale"
          }
        },
        "type": "object",
        "required": [
          "id",
          "revision_id",
          "source_epoch",
          "source_snapshot",
          "checks",
          "status",
          "created_at",
          "stale"
        ],
        "title": "RunOut"
      },
      "SourceInput": {
        "properties": {
          "source_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "title": "Source Key"
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "text": {
            "type": "string",
            "maxLength": 100000,
            "minLength": 1,
            "title": "Text"
          },
          "rules": {
            "items": {
              "$ref": "#/components/schemas/RuleInput"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Rules"
          },
          "valid_from": {
            "type": "string",
            "format": "date-time",
            "title": "Valid From"
          },
          "valid_until": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Valid Until"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_key",
          "title",
          "text",
